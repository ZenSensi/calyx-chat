rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Support operators are listed in /admins/{uid}. Add them by hand in the Firebase console.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lets the admin page check its own operator's status; nobody can write here from a client.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // User directory: any signed-in user can search it, but each user writes only their own doc.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /chat_conversations/{conversationId} {
      function isParticipant(data) {
        return signedIn() && request.auth.uid in data.participants;
      }

      // A support ticket's id is fixed to its owner, so nobody can claim another user's ticket.
      function validSupportId() {
        return !conversationId.matches('support_.*')
          || conversationId == 'support_' + request.auth.uid;
      }

      // Reading a doc that doesn't exist yet (checking for a DM or ticket) reveals nothing.
      allow get: if isAdmin() || (signedIn() && resource == null) || isParticipant(resource.data);
      allow list: if isAdmin() || isParticipant(resource.data);

      allow create: if isAdmin()
        || (isParticipant(request.resource.data) && validSupportId());

      // Members of a space can add people (never remove). DM and support participants are fixed.
      function participantsChangeAllowed() {
        return request.resource.data.participants == resource.data.participants
          || (resource.data.type == 'space'
              && request.resource.data.participants.hasAll(resource.data.participants));
      }

      allow update: if isAdmin()
        || (isParticipant(resource.data)
            && request.resource.data.type == resource.data.type
            && participantsChangeAllowed());

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function conv() {
          return get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data;
        }

        allow read: if isAdmin() || isParticipant(conv());

        // Users send as themselves. The one exception is the automatic welcome line
        // that app.js posts as 'support-admin' when a user opens their own ticket.
        allow create: if isAdmin() || (isParticipant(conv()) && (
          request.resource.data.senderUid == request.auth.uid
          || (conversationId == 'support_' + request.auth.uid
              && request.resource.data.senderUid == 'support-admin'
              && request.resource.data.text == 'Welcome to Calyx Support! A member of our team will assist you shortly.')
        ));

        // Edit / soft-delete: only the sender, and only these fields.
        allow update: if isAdmin() || (
          isParticipant(conv())
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'isDeleted'])
        );

        allow delete: if isAdmin();
      }
    }
  }
}
